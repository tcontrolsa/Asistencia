rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REGLAS DE SEGURIDAD TCONTROL ASISTENCIA (2026)
    // Protege la integridad de datos, previene borrados destructivos
    // y asegura la inmutabilidad de logs de auditoría.
    // ============================================================

    // Colección 'empleados'
    // Lectura pública para login y verificación de credencial.
    // Creación y actualización permitidas con campos mínimos requeridos.
    // ELIMINACIÓN PROHIBIDA desde clientes web para proteger la base de personal.
    match /empleados/{empleadoId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id']);
      allow delete: if false;
    }

    // Colección 'registros' (Marcaciones de asistencia)
    // Permite registrar eventos de asistencia válidos.
    match /registros/{registroId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true; // Requerido por el archivador histórico
    }

    // Colección 'dispositivos' (Vínculos de tokens de timbrado)
    match /dispositivos/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colección 'configuracion' (Parámetros globales del sistema)
    // Lectura para geocercas y horarios; borrado prohibido.
    match /configuracion/{configId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colecciones de consumo y pedidos de almuerzos
    match /consumo_almuerzos/{almuerzoId} {
      allow read, write: if true;
    }
    match /solicitudes_invitados/{solicitudId} {
      allow read, write: if true;
    }

    // Colecciones de Auditoría y Logs (Inmutables: Solo creación, no alteración ni borrado)
    match /auditoria_almuerzos/{auditoriaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs_whatsapp/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Colección 'notificaciones' (campana de la app y del panel)
    // Los avisos los crea y limpia Apps Script (notificaciones.gs); el cliente solo los lee
    // y se marca como lector (campo leidaPor). Texto mínimo: sin notas ni comentarios.
    match /notificaciones/{avisoId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidaPor']);
      allow delete: if true; // limpieza automática de avisos de más de 60 días
    }

    // Colección 'solicitudes_permiso' (permisos y vacaciones, JS/permisos.js)
    // La crea el colaborador (o TTHH a su nombre); la resuelven el jefe inmediato o TTHH;
    // Apps Script (permisos_escalado.gs) la pasa a TTHH. Solo se crea en un estado inicial válido
    // y no se borra: queda como historial. Se endurecerá con Firebase Auth en la etapa 2 de seguridad.
    match /solicitudes_permiso/{solicitudId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['empleadoId', 'tipo', 'estado', 'fechas'])
                    && request.resource.data.estado in ['PENDIENTE_JEFE', 'PENDIENTE_TTHH', 'REGISTRADA'];
      allow update: if request.resource.data.empleadoId == resource.data.empleadoId
                    && request.resource.data.tipo == resource.data.tipo;
      allow delete: if false;
    }

    // Colección 'empleados_desvinculados' (Historial laboral pasivo LOPDP)
    // Custodia de registros pasivos: no pueden eliminarse desde clientes.
    match /empleados_desvinculados/{desvinculadoId} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
