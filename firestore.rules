rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REGLAS DE SEGURIDAD TCONTROL ASISTENCIA (2026)
    // Protege la integridad de datos, previene borrados destructivos
    // y asegura la inmutabilidad de logs de auditoría.
    // ============================================================

    // Colección 'empleados'
    // Lectura pública para login y verificación de credencial.
    // Creación y actualización permitidas con campos mínimos requeridos.
    // ELIMINACIÓN PROHIBIDA desde clientes web para proteger la base de personal.
    match /empleados/{empleadoId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id']);
      allow delete: if false;
    }

    // Colección 'registros' (Marcaciones de asistencia)
    // Permite registrar eventos de asistencia válidos.
    match /registros/{registroId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true; // Requerido por el archivador histórico
    }

    // Colección 'dispositivos' (Vínculos de tokens de timbrado)
    match /dispositivos/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colección 'configuracion' (Parámetros globales del sistema)
    // Lectura para geocercas y horarios; borrado prohibido.
    match /configuracion/{configId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colecciones de consumo y pedidos de almuerzos
    match /consumo_almuerzos/{almuerzoId} {
      allow read, write: if true;
    }
    match /solicitudes_invitados/{solicitudId} {
      allow read, write: if true;
    }

    // Colecciones de Auditoría y Logs (Inmutables: Solo creación, no alteración ni borrado)
    match /auditoria_almuerzos/{auditoriaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs_whatsapp/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Colección 'empleados_desvinculados' (Historial laboral pasivo LOPDP)
    // Custodia de registros pasivos: no pueden eliminarse desde clientes.
    match /empleados_desvinculados/{desvinculadoId} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
