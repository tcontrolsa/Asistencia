rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección 'empleados'
    match /empleados/{empleadoId} {
      allow read: if true;
      // Se requiere escritura/actualización para vincular tokens de dispositivos y flags de supervisor
      allow write, update: if true; 
    }

    // Colección 'registros' (Marcaciones)
    match /registros/{registroId} {
      allow read: if true;
      allow create, update: if true;
      // Se requiere borrar registros durante el archivado histórico por lotes
      allow delete: if true; 
    }

    // Colección 'dispositivos' (Vincular tokens de timbrado)
    match /dispositivos/{deviceId} {
      allow read, write: if true;
    }

    // Colección 'configuracion' (Configuración general del sistema)
    match /configuracion/{configId} {
      allow read, write: if true;
    }

    // Colección de consumos y auditorías de almuerzos
    match /consumo_almuerzos/{almuerzoId} {
      allow read, write: if true;
    }
    match /auditoria_almuerzos/{auditoriaId} {
      allow read, write: if true;
    }

    // Colección 'logs_whatsapp' (Auditoría de envíos de WhatsApp)
    match /logs_whatsapp/{logId} {
      allow read, write: if true;
    }

    // Colección 'empleados_desvinculados' (Historial de personal desvinculado)
    match /empleados_desvinculados/{desvinculadoId} {
      allow read, write: if true;
    }

    // Colección 'logs' (Auditoría general de eventos del sistema)
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Colección 'solicitudes_invitados' (Almuerzos extra y refrigerios para invitados)
    match /solicitudes_invitados/{solicitudId} {
      allow read, write: if true;
    }
  }
}
