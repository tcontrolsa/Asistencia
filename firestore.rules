rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REGLAS DE SEGURIDAD TCONTROL ASISTENCIA (2026)
    // Protege la integridad de datos, previene borrados destructivos
    // y asegura la inmutabilidad de logs de auditoría.
    // ============================================================

    // ------------------------------------------------------------
    // Sesión de Firebase Auth (seguridad etapa 1): uid = ID del colaborador y rol firmado por el
    // servidor (sesion_firebase.gs): master, admin, supervisor, colaborador o guardia (terminal).
    // Apps Script escribe con la cuenta de servicio, que no pasa por estas reglas.
    // ------------------------------------------------------------
    function conSesion() { return request.auth != null; }
    function rolSesion() { return conSesion() ? request.auth.token.get('rol', '') : ''; }
    function esGestor() { return rolSesion() in ['master', 'admin', 'supervisor']; }
    function esAdmin() { return rolSesion() in ['master', 'admin']; }
    function esPropia(id) { return conSesion() && request.auth.uid == id; }
    function camposCambiados() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Fecha 'YYYY-MM-DD' → timestamp (medianoche UTC)
    function fechaIso(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function aFecha(s) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // Permiso de campo que la app aprueba sola (firebase_backend.solicitarCampo): hasta 15 días, que no empiece
    // en el pasado y nunca para personal externo. Lo más largo lo aprueba un supervisor admin.
    function campoAutomaticoValido(d) {
      return request.auth.token.get('externo', false) != true
        && d.campo_autorizado == true
        && d.campo_solicitud.get('automatica', false) == true
        && fechaIso(d.campo_desde) && fechaIso(d.campo_hasta)
        && aFecha(d.campo_hasta) >= aFecha(d.campo_desde)
        && aFecha(d.campo_hasta) - aFecha(d.campo_desde) <= duration.value(14, 'd')
        && aFecha(d.campo_desde) >= request.time - duration.value(2, 'd');
    }

    // Colección 'empleados'
    // Lectura pública por ahora (pantalla de ingreso: nombre y foto del ID); se cerrará en otro paso.
    // Escritura (seguridad etapa 2):
    //   - supervisores con sesión: cualquier ficha; el rol (supervisor/rol) solo lo cambian master y admin;
    //   - la propia persona: solo sus datos de perfil, su teléfono vinculado, el aviso de teletrabajo, su solicitud
    //     de campo y el permiso de campo automático válido;
    //   - nadie escribe contraseñas (viven en la hoja privada CREDENCIALES) ni tiene_clave (lo pone el servidor).
    // ELIMINACIÓN PROHIBIDA desde clientes web para proteger la base de personal.
    match /empleados/{empleadoId} {
      allow read: if true;
      allow create: if esGestor()
                    && request.resource.data.keys().hasAll(['id'])
                    && !request.resource.data.keys().hasAny(['pin', 'tiene_clave'])
                    && (esAdmin() || !request.resource.data.keys().hasAny(['rol']));
      allow update: if request.resource.data.keys().hasAll(['id'])
                    && !camposCambiados().hasAny(['pin', 'tiene_clave'])
                    && (
                      (esGestor() && (esAdmin() || !camposCambiados().hasAny(['supervisor', 'rol'])))
                      || (esPropia(empleadoId) && camposCambiados().hasOnly([
                            'deviceToken', 'id_dispositivo', 'nombre', 'foto_url', 'telefono', 'fechaNacimiento',
                            'baseLat', 'baseLng', 'teletrabajo_aviso', 'campo_solicitud'])
                          // desvincular su teléfono vacía id_dispositivo; ponerle otro valor solo lo hace un supervisor
                          && (!camposCambiados().hasAny(['id_dispositivo']) || request.resource.data.id_dispositivo == ''))
                      || (esPropia(empleadoId)
                          && camposCambiados().hasOnly(['campo_autorizado', 'campo_desde', 'campo_hasta', 'campo_motivo', 'campo_solicitud'])
                          && campoAutomaticoValido(request.resource.data))
                    );
      allow delete: if false;
    }

    // Colección 'registros' (Marcaciones de asistencia)
    // Permite registrar eventos de asistencia válidos.
    match /registros/{registroId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true; // Requerido por el archivador histórico
    }

    // Colección 'dispositivos' (Vínculos de tokens de timbrado)
    match /dispositivos/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colección 'configuracion' (Parámetros globales del sistema)
    // Lectura para geocercas y horarios; borrado prohibido.
    // Escritura (seguridad etapa 2): supervisores con sesión; el acceso a pestañas solo master y admin;
    // el portal de soporte (soporte.html) guarda sus vínculos y tickets con la sesión de cualquier colaborador.
    // Apps Script (túnel, simulaciones, candados) escribe con la cuenta de servicio.
    match /configuracion/{configId} {
      allow read: if true;
      allow create, update: if (configId == 'acceso_pestanas' && esAdmin())
                            || (configId != 'acceso_pestanas' && esGestor())
                            || (configId in ['soporte_vinculos', 'soporte_tickets'] && conSesion());
      allow delete: if false;
    }

    // Colecciones de consumo y pedidos de almuerzos
    match /consumo_almuerzos/{almuerzoId} {
      allow read, write: if true;
    }
    match /solicitudes_invitados/{solicitudId} {
      allow read, write: if true;
    }

    // Colecciones de Auditoría y Logs (Inmutables: Solo creación, no alteración ni borrado)
    match /auditoria_almuerzos/{auditoriaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs_whatsapp/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Colección 'notificaciones' (campana de la app y del panel)
    // Los avisos los crea y limpia Apps Script (notificaciones.gs); el cliente solo los lee
    // y se marca como lector (campo leidaPor). Texto mínimo: sin notas ni comentarios.
    match /notificaciones/{avisoId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leidaPor']);
      allow delete: if true; // limpieza automática de avisos de más de 60 días
    }

    // Colección 'solicitudes_permiso' (permisos y vacaciones, JS/permisos.js)
    // La crea el colaborador (o TTHH a su nombre); la resuelven el jefe inmediato o TTHH;
    // Apps Script (permisos_escalado.gs) la pasa a TTHH. Solo se crea en un estado inicial válido
    // y no se borra: queda como historial. Se endurecerá con Firebase Auth en la etapa 2 de seguridad.
    match /solicitudes_permiso/{solicitudId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['empleadoId', 'tipo', 'estado', 'fechas'])
                    && request.resource.data.estado in ['PENDIENTE_JEFE', 'PENDIENTE_TTHH', 'REGISTRADA'];
      allow update: if request.resource.data.empleadoId == resource.data.empleadoId
                    && request.resource.data.tipo == resource.data.tipo;
      allow delete: if false;
    }

    // Colección 'empleados_desvinculados' (Historial laboral pasivo LOPDP)
    // Custodia de registros pasivos: no pueden eliminarse desde clientes.
    match /empleados_desvinculados/{desvinculadoId} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
